---
// SSG -- > SSR
export const prerender = false

import BaseLayout from "../layouts/BaseLayout.astro";

const res = await fetch("https://api.coinpaprika.com/v1/tickers/btc-bitcoin")
if(!res.ok) {
    throw new Error("Fallo al conectarse al api:"+res.status)
}



const datos = await res.json()
const precioBitcoin = datos.quotes.USD.price
const precioBitcoinFixed = precioBitcoin.toFixed(2)
---

<BaseLayout>
    <h1>Precio del Bitcoin: </h1>
    <p>1 BTC = {precioBitcoinFixed}$</p>
</BaseLayout>
